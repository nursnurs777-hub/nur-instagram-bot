# Скопируйте в .env для локального запуска. На Render те же переменные задаются в Environment.

# --- Магазин
STORE_NAME=NUR Electronics
STORE_INSTAGRAM=@nurelectronics.kz
STORE_ADDRESS=Астана, ул. Төле би, 52
STORE_HOURS=ежедневно с 10:00 до 20:00
STORE_WHATSAPP=https://wa.me/77028081111

# --- Instagram (Meta for Developers → ваше приложение → Instagram → API setup with Instagram login)
IG_VERIFY_TOKEN=придумайте-любую-строку
IG_APP_SECRET=секрет-приложения-Instagram
IG_ACCESS_TOKEN=долгоживущий-токен-аккаунта
IG_ACCOUNT_ID=ID-инстаграм-аккаунта-магазина
GRAPH_API_VERSION=v23.0

# --- Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
WEB_SEARCH_ENABLED=true

# --- Google Sheets (один из двух способов доступа)
SPREADSHEET_ID=10DffuB-MxD2ntIxL6-ix2xHtHHMQ34tFgP-oH37req8
GOOGLE_SERVICE_ACCOUNT_JSON=          # весь JSON ключа одной строкой (таблицу расшарить на email сервисного аккаунта)
GOOGLE_API_KEY=                       # или ключ API, если таблица открыта по ссылке
TRADEIN_SHEET=Закуп б/у
# PRICE_FILE=tests/fixtures/price_nur.txt   # офлайн-прайс для разработки

# --- База (локально SQLite; на Render подставится Postgres)
DATABASE_URL=sqlite:///./local.db

# --- Поведение
ALLOWED_USER_IDS=                     # IGSID через запятую — отвечать только им (на время теста)
MANAGER_PAUSE_MINUTES=5
RESUME_AFTER_PAUSE=true
DEBOUNCE_SECONDS=4
FOLLOWUP_ENABLED=false
ADMIN_TOKEN=придумайте-длинный-токен
